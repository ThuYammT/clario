<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="view_ocr_document_form" model="ir.ui.view">
    <field name="name">ocr.document.form</field>
    <field name="model">ocr.document</field>
    <field name="priority">1</field>
    <field name="arch" type="xml">

      <form string="OCR Document">

        <!-- ================= HEADER ================= -->
        <header>

          <button name="action_run_ocr"
                  type="object"
                  string="Run"
                  class="btn-primary"
                  invisible="status not in ('draft','failed')"/>

          <button name="action_retry"
                  type="object"
                  string="Retry"
                  class="btn-secondary"
                  invisible="status != 'failed'"/>

          <button name="action_mark_reviewed"
                  type="object"
                  string="Mark Reviewed"
                  class="btn-outline-primary"
                  invisible="status != 'done'"/>

          <button name="action_create_vendor_bill"
                  type="object"
                  string="Create Vendor Bill"
                  class="btn-primary"
                  invisible="status != 'done' or vendor_bill_id != False"/>

          <button name="action_open_vendor_bill"
                  type="object"
                  string="Open Vendor Bill"
                  class="btn-secondary"
                  invisible="vendor_bill_id == False"/>

          <field name="status"
                 widget="statusbar"
                 statusbar_visible="draft,processing,done,reviewed,failed"/>

        </header>

        <!-- ================= BODY ================= -->
        <sheet>

          <field name="vendor_bill_id" invisible="1"/>
          <field name="file_filename" invisible="1"/>

          <!-- Title -->
          <div class="oe_title">
            <h1>
              <field name="name" readonly="1"/>
            </h1>

            <div style="margin-top:6px;display:flex;gap:14px;flex-wrap:wrap;">
              <span><strong>Type:</strong> <field name="document_type" readonly="1"/></span>
              <span><strong>Doc No:</strong> <field name="invoice_id" readonly="1"/></span>
              <span><strong>Date:</strong> <field name="invoice_date" readonly="1"/></span>
              <span><strong>Confidence:</strong> <field name="confidence_score" readonly="1"/></span>
            </div>
          </div>

          <div class="o_row" style="margin-top:14px; gap:14px;">

            <!-- ================= LEFT SIDE ================= -->
            <div class="o_col-6"
                 style="border:1px solid #e5e7eb;border-radius:14px;padding:14px;">

              <h3>Extracted Information</h3>

              <notebook>

                <!-- ================= PARTIES ================= -->
                <page string="Parties">
                  <group col="2">
                    <separator string="Seller" colspan="2"/>

                    <field name="vendor_name"/>

                    <!-- HIDE IN RECEIPT -->
                    <field name="vendor_branch_name"
                           invisible="document_type == 'receipt'"/>

                    <field name="vendor_tax_id"
                           invisible="document_type == 'receipt'"/>

                    <field name="vendor_address" colspan="2"/>

                    <!-- HIDE IN INVOICE -->
                    <field name="vendor_phone"
                           invisible="document_type == 'invoice'"/>

                    <!-- HIDE IN RECEIPT -->
                    <field name="vendor_website"
                           invisible="document_type == 'receipt'"/>

                    <!-- CUSTOMER (HIDE FOR RECEIPT) -->
                    <separator string="Customer" colspan="2"
                               invisible="document_type == 'receipt'"/>

                    <field name="customer_name"
                           invisible="document_type == 'receipt'"/>

                    <field name="customer_tax_id"
                           invisible="document_type == 'receipt'"/>

                    <field name="customer_address" colspan="2"
                           invisible="document_type == 'receipt'"/>

                    <!-- HIDE IN INVOICE -->
                    <field name="customer_phone"
                           invisible="document_type == 'invoice'"/>

                  </group>
                </page>

                <!-- ================= DOCUMENT INFO ================= -->
                <page string="Document Info">
                  <group col="2">
                    <field name="invoice_id"/>
                    <field name="invoice_date"/>

                    <field name="due_date"
                           invisible="document_type == 'receipt'"/>

                    <field name="payment_terms"
                           invisible="document_type == 'receipt'"/>

                    <field name="reference_number"
                           invisible="document_type == 'receipt'"/>

                    <field name="currency_id" readonly="1"/>
                  </group>
                </page>

                <!-- ================= LINE ITEMS ================= -->
                <page string="Line Items">
                  <field name="line_ids" nolabel="1">
                    <tree editable="bottom">
                      <field name="product_code"/>
                      <field name="description"/>
                      <field name="quantity"/>
                      <field name="unit_price"/>
                      <field name="discount_amount"/>
                      <field name="tax_rate"/>
                      <field name="total_amount"/>
                    </tree>
                  </field>
                </page>

                <!-- ================= TOTALS ================= -->
                <page string="Totals">

                  <group col="2">

                    <separator string="Base Calculations" colspan="2"
                               invisible="document_type == 'receipt'"/>

                    <field name="subtotal_excl_vat_excl_discount"
                           readonly="1"
                           invisible="document_type == 'receipt'"/>

                    <field name="subtotal_incl_vat_excl_discount"
                           readonly="1"
                           invisible="document_type == 'receipt'"/>

                    <field name="subtotal_excl_vat_incl_discount"
                           readonly="1"
                           invisible="document_type == 'receipt'"/>

                    <separator string="Adjustments" colspan="2"/>

                    <field name="discount_amount"
                           invisible="document_type == 'receipt'"/>

                    <field name="vat_amount"/>

                    <separator string="Final Result" colspan="2"/>

                    <field name="total_payable"
                           readonly="1"
                           class="oe_inline"
                           style="font-weight:600;font-size:16px;"/>

                  </group>

                </page>

              </notebook>

            </div>

            <!-- ================= RIGHT SIDE ================= -->
            <div class="o_col-6"
                 style="border:1px solid #e5e7eb;border-radius:14px;padding:14px;">

              <h3 style="margin:0 0 10px 0;">Original Document</h3>

              <div class="text-muted" style="margin-bottom:8px;">
                Upload and preview the original PDF/image.
              </div>

              <field name="file"
                     filename="file_filename"
                     widget="binary"
                     options="{'accept': '.pdf,.png,.jpg,.jpeg'}"/>

              <div style="margin-top:12px;">

                <field name="file"
                       filename="file_filename"
                       widget="pdf_viewer"
                       nolabel="1"
                       invisible="not id or not file or '.pdf' not in (file_filename or '')"
                       style="height:650px;width:100%;"/>

                <field name="file"
                       filename="file_filename"
                       widget="image"
                       nolabel="1"
                       invisible="not id or not file or '.pdf' in (file_filename or '')"
                       style="max-width:100%;height:auto;border:1px solid #ddd;border-radius:6px;"/>

                <div class="text-muted"
                     invisible="id"
                     style="margin-top:8px;">
                  Save the record to enable preview.
                </div>

              </div>

              <notebook style="margin-top:14px;">
                <page string="Extraction Log">
                  <field name="extraction_log" nolabel="1" readonly="1"/>
                </page>
                <page string="Raw OCR Text">
                  <field name="extracted_text" nolabel="1" readonly="1"/>
                </page>
                <page string="Errors">
                  <field name="ocr_error_message" nolabel="1" readonly="1"/>
                </page>

                <page string="Debug Comparison">
                  <group>
                    <separator string="Azure Raw Response"/>
                    <field name="azure_raw_response"
                           nolabel="1"
                           readonly="1"
                           widget="text"
                           style="height:300px;"/>

                    <separator string="Post Processed Data"/>
                    <field name="post_processed_response"
                           nolabel="1"
                           readonly="1"
                           widget="text"
                           style="height:300px;"/>
                  </group>
                </page>

              </notebook>

            </div>

          </div>

        </sheet>

      </form>

    </field>
  </record>

</odoo>