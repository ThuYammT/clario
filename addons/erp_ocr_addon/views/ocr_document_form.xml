<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_ocr_document_form" model="ir.ui.view">
    <field name="name">ocr.document.form</field>
    <field name="model">ocr.document</field>
    <field name="arch" type="xml">

      <form string="OCR Document">

        <!-- ================= HEADER ================= -->
        <header>
          <button name="action_run_ocr"
                  type="object"
                  string="Run OCR"
                  class="btn-primary"/>

          <field name="status"
                 widget="statusbar"
                 statusbar_visible="uploaded,processing,completed,error"/>
        </header>

        <sheet>

          <!-- ================= BASIC INFO ================= -->
          <group col="4">
            <field name="name"/>
            <field name="doc_type"/>
            <field name="document_number"/>
            <field name="document_date"/>

            <field name="upload_date" readonly="1"/>
            <field name="user_id" readonly="1"/>
            <field name="currency_id"/>
            <field name="is_tax_invoice"/>
          </group>

          <!-- ================= OCR META ================= -->
          <group col="2">
            <field name="confidence_score" readonly="1"/>
            <field name="progress" widget="progressbar" readonly="1"/>
          </group>

          <notebook>

            <!-- ================= PARTIES ================= -->
            <page string="Vendor / Customer">

              <group string="Vendor" col="2">
                <field name="vendor_name"/>
                <field name="vendor_branch_code"/>
                <field name="vendor_tax_id"/>
                <field name="vendor_phone"/>
                <field name="vendor_address"/>
              </group>

              <group string="Customer" col="2">
                <field name="customer_name"/>
                <field name="customer_tax_id"/>
                <field name="customer_phone"/>
                <field name="customer_address"/>
              </group>

            </page>

            <!-- ================= DOCUMENT INFO ================= -->
            <page string="Document Info">
              <group col="2">
                <field name="reference_number"/>

                <field name="invoice_date"
                      modifiers="{'invisible': [['doc_type', '=', 'receipt']]}"/>

                <field name="receipt_date"
                      modifiers="{'invisible': [['doc_type', '=', 'invoice']]}"/>

                <field name="receipt_number"
                      modifiers="{'invisible': [['doc_type', '=', 'invoice']]}"/>
              </group>
            </page>


            <!-- ================= ITEMS ================= -->
            <page string="Items">
              <field name="line_ids">
                <tree editable="bottom">
                  <field name="item_no"/>
                  <field name="description"/>
                  <field name="quantity"/>
                  <field name="unit_price"/>
                  <field name="discount"/>
                  <field name="vat_rate"/>
                  <field name="line_total" readonly="1"/>
                </tree>
              </field>
            </page>

            <!-- ================= AMOUNTS ================= -->
            <page string="Amounts">
              <group col="2">
                <field name="subtotal_amount"/>
                <field name="discount_total"/>
                <field name="net_amount"/>
                <field name="vat_rate"/>
                <field name="vat_base_amount"/>
                <field name="vat_amount"/>
                <field name="grand_total"/>
              </group>
            </page>

            <!-- ================= OCR DEBUG ================= -->
            <page string="Raw OCR Text">
              <field name="extracted_text" nolabel="1"/>
            </page>

            <page string="Extraction Log">
              <field name="extraction_log" nolabel="1"/>
            </page>

          </notebook>

          <!-- ================= FILE ================= -->
          <group>
            <field name="file" widget="image"/>
          </group>

        </sheet>
      </form>

    </field>
  </record>
</odoo>
