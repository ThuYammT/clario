<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_ocr_dashboard_server" model="ir.actions.server">
        <field name="name">Dashboard</field>
        <field name="model_id" ref="model_ocr_dashboard"/>
        <field name="state">code</field>
        <field name="code">
            action = model.action_get_dashboard()
        </field>
    </record>

    <menuitem id="menu_ocr_root"
              name="Clario OCR"
              web_icon="erp_ocr_addon,static/description/icon.png"
              sequence="10"/>

    <menuitem id="menu_ocr_dashboard"
              name="Dashboard"
              parent="menu_ocr_root"
              action="action_ocr_dashboard_server"
              sequence="1"/>

    <menuitem id="menu_upload_invoice"
              name="Upload Invoice"
              parent="menu_ocr_root"
              action="action_ocr_document_upload_invoice"
              sequence="10"/>

    <menuitem id="menu_upload_receipt"
              name="Upload Receipt"
              parent="menu_ocr_root"
              action="action_ocr_document_upload_receipt"
              sequence="20"/>

    <menuitem id="menu_ocr_history"
              name="History"
              parent="menu_ocr_root"
              action="action_ocr_document_list"
              sequence="30"/>

</odoo>