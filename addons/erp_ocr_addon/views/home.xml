<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="view_ocr_home_form" model="ir.ui.view">
    <field name="name">ocr.home.form</field>
    <field name="model">ocr.home</field>
    <field name="arch" type="xml">
      <form string="Clario OCR" create="false" edit="false">
        <sheet>

          <div class="oe_title">
            <h1>Clario OCR</h1>
            <div class="text-muted" style="margin-top:6px;">
              Enterprise Document Intelligence (Invoice / Receipt)
            </div>
          </div>

          <div class="o_row" style="margin: 12px 0 18px 0;">
            <div class="o_col-12" style="display:flex;gap:10px;flex-wrap:wrap;">
              <button string="Upload Invoice" type="action" name="%(action_upload_invoice)d" class="btn-primary"/>
              <button string="Upload Receipt" type="action" name="%(action_upload_receipt)d" class="btn-secondary"/>
              <button string="History" type="action" name="%(action_ocr_document_history)d" class="btn-outline-primary"/>
            </div>
          </div>

        </sheet>
      </form>
    </field>
  </record>

</odoo>
